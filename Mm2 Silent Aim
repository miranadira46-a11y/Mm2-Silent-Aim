-- ============================================
-- GET ROLE
-- ============================================
local function GetRole(plr)
    if not plr then return "Unknown" end
    local char = plr.Character
    
    if char then
        for _, t in pairs(char:GetChildren()) do
            if t:IsA("Tool") then
                local n = t.Name:lower()
                if n:find("knife") then return "Murder" end
                if n:find("gun") or n:find("revolver") then return "Sheriff" end
            end
        end
    end
    
    local bp = plr:FindFirstChild("Backpack")
    if bp then
        for _, t in pairs(bp:GetChildren()) do
            if t:IsA("Tool") then
                local n = t.Name:lower()
                if n:find("knife") then return "Murder" end
                if n:find("gun") or n:find("revolver") then return "Sheriff" end
            end
        end
    end
    
    for name, value in pairs(plr:GetAttributes()) do
        local n = name:lower()
        local v = tostring(value):lower()
        if n:find("role") or n:find("team") then
            if v:find("murder") then return "Murder" end
            if v:find("sheriff") then return "Sheriff" end
            if v:find("innocent") then return "Innocent" end
        end
    end
    
    if char then
        for name, value in pairs(char:GetAttributes()) do
            local n = name:lower()
            local v = tostring(value):lower()
            if n:find("role") or n:find("team") then
                if v:find("murder") then return "Murder" end
                if v:find("sheriff") then return "Sheriff" end
                if v:find("innocent") then return "Innocent" end
            end
        end
    end
    
    return "Innocent"
end

local function IsAlive(plr)
    if not plr or not plr.Character then return false end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function GetMurder()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and IsAlive(plr) then
            if GetRole(plr) == "Murder" then return plr end
        end
    end
    return nil
end

-- ============================================
-- CARI GUN & REMOTE
-- ============================================
local function GetGunTool()
    local char = LocalPlayer.Character
    if char then
        for _, t in pairs(char:GetChildren()) do
            if t:IsA("Tool") then return t end
        end
    end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, t in pairs(bp:GetChildren()) do
            if t:IsA("Tool") then
                local n = t.Name:lower()
                if n:find("gun") or n:find("revolver") or n:find("pistol") then
                    return t
                end
            end
        end
    end
    return nil
end

-- SILENT EQUIP TANPA WAIT (langsung pindah parent)
local function SilentEquipInstant()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool then return end
    local gun = GetGunTool()
    if not gun then return end
    pcall(function() gun.Parent = char end)
end

local ShootRemote = nil

local function FindRemote()
    local char = LocalPlayer.Character
    if char then
        for _, t in pairs(char:GetChildren()) do
            if t:IsA("Tool") then
                local r = t:FindFirstChild("Shoot")
                if r and r:IsA("RemoteEvent") then
                    ShootRemote = r
                    return r
                end
            end
        end
    end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, t in pairs(bp:GetChildren()) do
            if t:IsA("Tool") then
                local r = t:FindFirstChild("Shoot")
                if r and r:IsA("RemoteEvent") then
                    ShootRemote = r
                    return r
                end
                for _, d in pairs(t:GetDescendants()) do
                    if d:IsA("RemoteEvent") and d.Name:lower():find("shoot") then
                        ShootRemote = d
                        return d
                    end
                end
            end
        end
    end
    return nil
end

LocalPlayer.CharacterAdded:Connect(function()
    ShootRemote = nil
    task.wait(0.2)
    FindRemote()
end)

-- ============================================
-- FIRE INSTANT (TANPA DELAY)
-- ============================================
local function FireInstant(target)
    if not target or not IsAlive(target) then return false end
    
    -- Silent equip INSTAN (gak ada wait)
    SilentEquipInstant()
    
    -- Cari remote kalau belum ada
    if not ShootRemote or not ShootRemote.Parent then FindRemote() end
    if not ShootRemote then return false end
    
    local part = target.Character:FindFirstChild(Config.TargetPart)
        or target.Character:FindFirstChild("Head")
        or target.Character:FindFirstChild("HumanoidRootPart")
    if not part then return false end
    
    local pos = part.Position
    if Config.Prediction > 0 then
        local hrp = target.Character:FindFirstChild("HumanoidRootPart")
        if hrp then pos = pos + (hrp.Velocity * Config.Prediction) end
    end
    
    local origin = Camera.CFrame
    local myHead = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
    if myHead then origin = myHead.CFrame end
    
    local targetCF = CFrame.new(pos)
    
    -- FIRE LANGSUNG (fire & forget, tanpa pcall blocking)
    ShootRemote:FireServer(origin, targetCF)
    
    -- Aktifin gun buat animasi (non-blocking)
    task.spawn(function()
        local gun = GetGunTool()
        if gun then
            pcall(function() gun:Activate() end)
        end
    end)
    
    return true
end

