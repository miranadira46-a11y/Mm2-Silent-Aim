local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "uwaiS_ESP"
ESPFolder.Parent = ScreenGui

local Highlights = {}
local LastRoles = {}
local LastCharacters = {}

local function RemoveESP(plr)
    if Highlights[plr] then
        pcall(function() Highlights[plr]:Destroy() end)
        Highlights[plr] = nil
    end
    LastRoles[plr] = nil
    LastCharacters[plr] = nil
end

local function AddESP(plr, color, role)
    if not plr.Character then return end
    
    if Highlights[plr] then
        if LastCharacters[plr] ~= plr.Character then
            Highlights[plr].Adornee = plr.Character
            LastCharacters[plr] = plr.Character
        end
        if LastRoles[plr] ~= role then
            Highlights[plr].OutlineColor = color
            Highlights[plr].FillColor = color
            LastRoles[plr] = role
        end
        return
    end
    
    local hl = Instance.new("Highlight")
    hl.Name = "uwaiS_HL_" .. plr.Name
    hl.Adornee = plr.Character
    hl.FillTransparency = 1
    hl.OutlineTransparency = 0
    hl.OutlineColor = color
    hl.FillColor = color
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = ESPFolder
    
    Highlights[plr] = hl
    LastRoles[plr] = role
    LastCharacters[plr] = plr.Character
end

local function UpdateESP()
    if not Running then return end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and IsAlive(plr) then
            local role = GetRole(plr)
            if role == "Murder" and Config.ESPMurder then
                AddESP(plr, Color3.fromRGB(255, 0, 0), "Murder")
            elseif role == "Sheriff" and Config.ESPSheriff then
                AddESP(plr, Color3.fromRGB(0, 100, 255), "Sheriff")
            elseif role == "Innocent" and Config.ESPInnocent then
                AddESP(plr, Color3.fromRGB(0, 255, 0), "Innocent")
            else
                RemoveESP(plr)
            end
        else
            RemoveESP(plr)
        end
    end
end

local function HookPlayer(plr)
    plr.CharacterAdded:Connect(function()
        task.wait(0.1)
        if Highlights[plr] then
            pcall(function() Highlights[plr]:Destroy() end)
            Highlights[plr] = nil
            LastRoles[plr] = nil
            LastCharacters[plr] = nil
        end
        UpdateESP()
    end)
end

Players.PlayerAdded:Connect(function(plr)
    HookPlayer(plr)
    task.wait(0.1)
    UpdateESP()
end)

Players.PlayerRemoving:Connect(function(plr)
    RemoveESP(plr)
end)

for _, plr in pairs(Players:GetPlayers()) do
